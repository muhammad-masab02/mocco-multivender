PORT= 8000

# Local URLs
FRONTEND_URL= http://localhost:5173
# BACKEND_URL= http://localhost:8000

# Production URLs
# FRONTEND_URL= https://mocco-mart.vercel.app

# Database
DB_NAME= mart_db_name
# Atlas MongoDB connection string 
# DATABASE_URL= your_database_url

# Local MongoDB compass connection string
DATABASE_URL= mongodb://localhost:27017

# admin credentials
ADMIN_NAME= Admin
ADMIN_EMAIL= admin@gmail.com
ADMIN_PASSWORD= your_admin_password


# JWT Configuration
JWT_SECRET_KEY= your_jwt_secret_key
JWT_EXPIRES= 1d

# Activation token secret key
ACTIVATION_TOKEN_SECRET_KEY= your_activation_token_secret_key
EXPIRES_ACTIVATION_TOKEN= 1m

# NODE_ENV 
VERCEL= 1
NODE_ENV= PRODUCTION/DEVELOPMENT

# SMTP Configuration for sending emails
SMPT_HOST= smtp.gmail.com
SMPT_PORT= 123
SMPT_MAIL= your_smpt_mail@gmail.com
SMPT_PASSWORD= your_smpt_password
SMPT_SERVICE= gmail

# Cloudinary (required on Vercel for avatar uploads)
CLOUDINARY_CLOUD_NAME= your_cloudinary_cloud_name
CLOUDINARY_API_KEY= your_cloudinary_api_key
CLOUDINARY_API_SECRET= your_cloudinary_api_secret

# Stripe Configuration
STRIPE_API_KEY= pk_stripe_api_key
STRIPE_SECRET_KEY= your_stripe_secret_key